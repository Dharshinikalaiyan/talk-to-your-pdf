# Copy this file to .env and fill in the values you need.
#   cp .env.example .env
# .env is git-ignored: never commit it, and never paste its values into a chat.

# --- Sign in with Google (see SIGN_IN_SETUP.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Sign in with Microsoft (optional) ---
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Optional answer engines ---
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# --- Only when deployed ---
# PUBLIC_URL=https://your-app.example.com
# SESSION_SECRET=a-long-random-string
